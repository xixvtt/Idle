{
  "name": "idle-desktop",
  "version": "0.1.0",
  "description": "Idle Desktop — floating overlay for Claude Code sessions.",
  "main": "dist-electron/main.js",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p electron/tsconfig.json",
    "electron:dev": "npm run build && electron .",
    "dist": "npm run build && electron-builder --mac --arm64 --x64",
    "dist:arm": "npm run build && electron-builder --mac --arm64",
    "typecheck": "tsc --noEmit && tsc -p electron/tsconfig.json --noEmit"
  },
  "build": {
    "appId": "com.idleapp.desktop",
    "productName": "Idle",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../daemon/dist/idle-daemon",
        "to": "daemon/idle-daemon"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        { "target": "zip", "arch": ["arm64", "x64"] }
      ],
      "icon": "build/icon.icns",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": "-",
      "extendInfo": {
        "LSUIElement": 1
      },
      "artifactName": "Idle-${version}-${arch}.zip"
    },
    "publish": null
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "electron-builder": "^26.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
